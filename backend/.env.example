# Copy to backend/.env (never commit backend/.env or key files).
# See docs/GEE_SETUP.md for creating your own GEE project + service account.

VIIRS_SOURCE=gee
GEE_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-service-account-key.json

# Local dev CORS
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:8080,http://127.0.0.1

VIIRS_DB_PATH=viirs_cache_local.db
VIIRS_HOTLIST_PATH=backend/data/hotlist.json
VIIRS_CLUSTERS_PATH=backend/data/clusters.json

MAX_INFLIGHT_NETWORK=4
RATE_LIMIT_PER_MIN=120
MIN_CF_CVG=5

# Optional: study-area JSON paths
# VIIRS_GULF_STUDY_PATH=backend/data/gulf_study_areas.json
# VIIRS_STRIKE_SITES_PATH=backend/data/conflict_strike_sites.json

# GDELT (scripts/build_conflict_strike_sites.py only)
# GDELT_CLOUD_API_KEY=
