# Backend environment (copy to .env and adjust)

# CORS (comma-separated). Avoid "*" in production.
CORS_ORIGINS=https://yourdomain.com

# Cache DB path (keep outside the repo checkout)
VIIRS_DB_PATH=/var/lib/viirs/cache/viirs_cache_prod.db

# Hotlist/clusters paths (absolute is safest in systemd)
VIIRS_HOTLIST_PATH=/srv/viirs/current/backend/data/hotlist.json
VIIRS_CLUSTERS_PATH=/srv/viirs/current/backend/data/clusters.json

# Data source: "noaa" (default) or "gee"
VIIRS_SOURCE=noaa

# If using NOAA auth (optional)
# NOAA_EOG_USERNAME=
# NOAA_EOG_PASSWORD=

# If using Earth Engine
# GEE_PROJECT_ID=
#
# In GEE mode, the backend expects a service-account key file path here:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json
#
# Setup guide: docs/GEE_SETUP.md

# Overload guards (tune for your VPS)
MAX_INFLIGHT_NETWORK=4
RATE_LIMIT_PER_MIN=60

# Data quality threshold
MIN_CF_CVG=5

# Uvicorn settings (only if you wire them into systemd ExecStart)
# HOST=0.0.0.0
# RELOAD=false

